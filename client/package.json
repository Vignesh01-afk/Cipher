{
  "name": "ciphernote-client",
  "private": true,
  "version": "1.0.0",
  "description": "CipherNote web client - all encryption and decryption happens here",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "design:check": "node scripts/design-check.mjs",
    "test": "node scripts/design-check.mjs && tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4"
  },
  "optionalDependencies": {
    "@fontsource/ibm-plex-sans": "^5.0.4",
    "@fontsource/ibm-plex-mono": "^5.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
