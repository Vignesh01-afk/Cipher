// CipherNote data model.
//
// SECURITY INVARIANT: nothing in this schema can be turned back into note
// plaintext by the server. Note titles, bodies and tags live *only* inside
// `Note.ciphertext`, which is produced by the browser with AES-GCM using a
// per-note key. That per-note key is itself wrapped (AES-GCM) with the owner's
// master key, and wrapped again (RSA-OAEP) for each recipient of a share.
// The server stores those opaque blobs and never holds a key that unwraps them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  displayName  String
  passwordHash String

  // ---- Google sign-in ------------------------------------------------------
  /// Google account subject (`sub` claim) when the account is linked.
  googleId String? @unique

  // ---- Master-key escrow (OTP password reset) ------------------------------
  // OTP-only reset model: the client uploads the raw master key ONCE over TLS
  // at registration (and again after a recovery reset), and the server wraps
  // it with a server-side secret (AES-256-GCM). This blob is NOT zero
  // knowledge - it exists so a verified Gmail OTP can recover the vault.
  /// Master key wrapped under the server escrow secret (AES-GCM, base64).
  escrowWrappedMasterKey String?
  /// IV for `escrowWrappedMasterKey`.
  escrowMasterKeyIv      String?
  /// Set when the escrow copy is re-stored after a recovery-key reset.
  escrowUpdatedAt        DateTime?

  // ---- Client-side key material (all opaque to the server) ----------------
  /// RSA-OAEP public key, SPKI, base64. Safe to publish to other users.
  publicKey         String
  /// PKCS#8 private key, encrypted with the user's master key (AES-GCM).
  wrappedPrivateKey String
  /// IV used when wrapping `wrappedPrivateKey`.
  privateKeyIv      String
  /// Salt for the password -> key-encryption-key (PBKDF2) derivation.
  kdfSalt           String
  /// PBKDF2 iteration count used for this user's KEK.
  kdfIterations     Int    @default(210000)
  /// Credential scheme used by `passwordHash`:
  ///   1 = legacy: bcrypt of the raw password (the server saw the password),
  ///   2 = current: bcrypt of the authKey - the SECOND half of a 512-bit
  ///       PBKDF2 derivation whose first half is the KEK. On this scheme the
  ///       server never receives the password or anything that derives it.
  /// Clients on v1 are migrated transparently on their next login via
  /// POST /auth/upgrade-auth.
  authVersion       Int    @default(1)
  /// The user's master key, wrapped with the password-derived KEK (AES-GCM).
  wrappedMasterKey  String
  /// IV used when wrapping `wrappedMasterKey`.
  masterKeyIv       String

  // ---- Password recovery (zero-knowledge) ---------------------------------
  // A one-time recovery key shown to the user at registration. The server
  // stores the master key re-wrapped under a recovery-key-derived KEK plus a
  // verifier (an HKDF value derived in the browser with the info string
  // "ciphernote-recovery-verifier"). The raw recovery key NEVER reaches the
  // server. Neither stored value lets the server decrypt anything: the
  // recovery KEK exists only in the user's browser during setup and reset.
  /// Master key wrapped with the recovery-key-derived KEK (AES-GCM). Null
  /// until the user generates a recovery key.
  wrappedMasterKeyRecovery  String?
  /// IV for `wrappedMasterKeyRecovery`.
  masterKeyRecoveryIv       String?
  /// PBKDF2 salt for the recovery-key -> KEK derivation.
  recoveryKdfSalt           String?
  /// PBKDF2 iterations for the recovery KEK.
  recoveryKdfIterations     Int?
  /// Server-side peppered hash of the client-computed recovery VERIFIER
  /// (HKDF-SHA256 of the raw key with a domain-separated info string), stored
  /// as `salt:sha256(salt || verifier)` and compared in constant time. Used to
  /// verify a presented verifier without ever holding the raw key.
  recoveryVerifier          String?
  /// Set when the recovery key is used, so a key cannot be reused.
  recoveryKeyUsedAt         DateTime?

  // ---- Chat identity (public handle, NOT a secret / NOT an encryption key) -
  /// Unique public chat handle, e.g. CN-7F4K29. Random, rotatable, and purely
  /// an addressing identifier: it never derives, wraps or unlocks any key.
  cipherId  String  @unique
  /// Unique public @username for chat addressing. Lowercase, 3-24 chars.
  username  String? @unique

  createdAt DateTime @default(now())

  notes             Note[]
  files             SecureFile[]
  sharesGiven       NoteShare[]           @relation("ShareOwner")
  sharesReceived    NoteShare[]           @relation("ShareRecipient")
  auditLogs         AuditLog[]
  otpTokens         OtpToken[]
  conversationLinks ConversationMember[]
  messagesSent      EncryptedMessage[]    @relation("MessageSender")
  blocksIssued      ChatBlock[]           @relation("Blocker")
  blocksReceived    ChatBlock[]           @relation("BlockedUser")
}

/// One-time codes emailed to the account address for password reset./// Codes are stored as SHA-256 hashes; a plain code never touches the DB.
model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256(code), hex. Deliberately not bcrypt: the code is 8 digits of
  /// entropy, so hashing must be cheap enough to verify quickly yet the
  /// lookup is always scoped by userId and consumed on first use.
  codeHash  String
  purpose   String   @default("PASSWORD_RESET")
  expiresAt DateTime
  usedAt    DateTime?
  /// Monotonic counter of emails sent for this purpose, for simple throttling.
  sentAt    DateTime
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

model Note {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// AES-GCM ciphertext (base64) of the JSON payload {title, content, tags}.
  ciphertext        String
  /// Unique 96-bit nonce (base64) for this ciphertext.
  iv                String
  /// Lets the client evolve the payload format without breaking old notes.
  encryptionVersion Int    @default(1)
  /// Human readable algorithm label, e.g. "AES-GCM-256".
  algorithm         String @default("AES-GCM-256")
  /// Length of the plaintext payload in bytes (metadata only, no content).
  payloadBytes      Int    @default(0)

  /// The per-note AES key, wrapped with the owner's master key.
  wrappedNoteKey String
  /// IV used when wrapping `wrappedNoteKey`.
  noteKeyIv      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares    NoteShare[]
  files     SecureFile[]
  auditLogs AuditLog[]

  @@index([ownerId])
}

/// A secure file attachment.
///
/// SECURITY INVARIANT: exactly like notes, the server never sees file
/// plaintext. The browser encrypts the file with a fresh per-file AES-GCM-256
/// key, wraps that key with the owner's master key, and uploads only the
/// ciphertext. `wrappedFileKey` is opaque to the server.
///
/// Storage: the encrypted blob lives in private server-side storage
/// (`server/storage/files/`, configurable) - never in a public bucket and
/// never with a publicly guessable URL. Downloads go through
/// `GET /api/files/:id/content`, which re-validates authentication and note
/// access on every request.
model SecureFile {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// The note this file is attached to. A file is only downloadable by users
  /// who can access that note (owner or active share holder).
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  /// Random name generated server-side for the stored blob. Contains no
  /// user input, so it cannot be used for path traversal.
  storageKey   String @unique
  /// Sanitised original filename, shown in the UI.
  filename     String
  /// MIME type reported by the browser at upload time.
  mimeType     String
  /// Exact byte length of the encrypted blob on disk.
  encryptedBytes Int
  /// Byte length of the original plaintext file (metadata only).
  plaintextBytes Int
  /// Optional lowercase extension, validated server-side.
  extension    String?

  /// The per-file AES key, wrapped with the owner's master key (AES-GCM).
  wrappedFileKey String
  /// IV used when wrapping `wrappedFileKey`.
  fileKeyIv      String

  /// The same file key, wrapped with the NOTE key. Every participant who can
  /// decrypt the note (owner via master wrap, recipients via their RSA-wrapped
  /// share) already holds the note key, so no extra file-sharing flow is
  /// needed - the existing note share grants file access automatically.
  wrappedForNoteKey String
  noteKeyWrapIv     String

  /// IV (base64) of the file ciphertext itself. Not secret, but required to
  /// decrypt; the server holds it without being able to use it.
  fileIv        String
  encryptionVersion Int    @default(1)
  algorithm         String @default("AES-GCM-256")

  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([noteId, deletedAt])
  @@index([ownerId, createdAt])
}

model NoteShare {
  id           String @id @default(cuid())
  noteId       String
  note         Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User   @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWithId String
  sharedWith   User   @relation("ShareRecipient", fields: [sharedWithId], references: [id], onDelete: Cascade)

  /// The note key, encrypted to the recipient with RSA-OAEP.
  wrappedKey   String
  keyAlgorithm String @default("RSA-OAEP-2048-SHA256")

  createdAt DateTime  @default(now())
  /// Soft revocation: a revoked share is kept for the audit trail but is
  /// excluded from every authorization check.
  revokedAt DateTime?

  @@unique([noteId, sharedWithId])
  @@index([sharedWithId])
  @@index([noteId])
}

// ============================================================================
// Chat
//
// SECURITY INVARIANT: identical to notes - the server stores chat ciphertext
// and wrapped key material only. `EncryptedMessage.ciphertext` is produced in
// the browser with AES-GCM-256 under a per-conversation key that the server
// never holds in unwrapped form (it receives that key RSA-OAEP-wrapped to
// each member's public key, exactly like a note key on a share).
// ============================================================================

/// A chat conversation. 1:1 DMs today; the member model already supports more.
model Conversation {
  id   String @id @default(cuid())
  /// Optional note context: the conversation was started from a shared note.
  /// No FK on purpose - deleting the note must not delete the conversation.
  contextNoteId String?
  /// Denormalised note title is NOT stored (would be plaintext metadata
  /// leakage); the client resolves the title from the note it can decrypt.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages EncryptedMessage[]

  @@index([updatedAt])
}

/// Membership join table with per-member chat key wrap + read state.
model ConversationMember {
  id             String @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The conversation's AES-256-GCM key, RSA-OAEP-wrapped with THIS member's
  /// public key. Opaque to the server, exactly like a NoteShare.wrappedKey.
  wrappedConversationKey String
  keyAlgorithm           String @default("RSA-OAEP-2048-SHA256")

  /// Soft-hide for the member ("clear local chat" / hide conversation).
  hiddenAt DateTime?
  /// When the member last read the conversation (unread counts, receipts).
  lastReadAt DateTime?

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

/// One encrypted chat message. SERVER CANNOT DECRYPT THIS.
model EncryptedMessage {
  id             String @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  /// AES-GCM-256 ciphertext (base64) of the JSON payload {type, text, ...}.
  ciphertext String
  /// 96-bit nonce (base64) for this ciphertext.
  iv         String
  encryptionVersion Int @default(1)
  algorithm  String @default("AES-GCM-256")
  /// Ciphertext byte length (metadata only, for stats/limits).
  payloadBytes Int @default(0)

  /// Client message id (uuid) for optimistic-send deduplication.
  clientId String?

  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

/// A user-blocks-user record. Blocking hides new traffic; the server enforces
/// it on send, so a blocked sender's messages are rejected server-side.
model ChatBlock {
  id        String @id @default(cuid())
  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model AuditLog {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// One of the AuditAction values (see src/lib/audit.ts).
  action     String
  targetType String?
  targetId   String?
  /// Optional relation so a note's history can be queried directly.
  noteId     String?
  note       Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)
  /// JSON string. Contains identifiers and counts only - never plaintext.
  metadata   String?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}
