# Copy this file to `server/.env` and adjust the values.

# Where the SQLite file lives (path is relative to the prisma/ directory).
DATABASE_URL="file:./dev.db"

# Port for the Express API.
PORT=4000

# Origin allowed by CORS (the Vite dev server).
CLIENT_ORIGIN="http://localhost:5173"

# Secret used to sign session JWTs.
# Generate a strong one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret"

# How long a session token stays valid.
JWT_EXPIRES_IN="12h"

# bcrypt work factor for password hashing.
BCRYPT_ROUNDS=12

# Rate limiting for authentication endpoints.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

NODE_ENV=development
