# Copy this file to `server/.env` and adjust the values.

# PostgreSQL connection string (Neon, Supabase, RDS, local Postgres, ...).
# The schema is Postgres-only; SQLite is not supported.
DATABASE_URL="postgresql://user:password@localhost:5432/ciphernote?schema=public"

# Neon: use the POOLED host (contains `-pooler`) and always set sslmode=require.
# With a cold compute, the pooler accepts the TCP immediately but the query waits
# for the compute to wake. Setting connect_timeout=15 and a single retry at the
# first connection (2 s, then 4 s) keeps the first request from returning a 500.
#
# Use the non-pooler host for management queries (migration maintainers): set
# DIRECT_URL to the non-pooler host if you need one, otherwise leave it out.
#
# Neon example (replace USER/PASSWORD and the host):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

PORT=4000

# Origin allowed by CORS (the Vite dev server). Comma-separated for several.
CLIENT_ORIGIN="http://localhost:5173"

# Secret used to sign session JWTs.
# Generate a strong one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret"

# How long a session token stays valid. Sessions are revocable server-side
# (User.tokenVersion is bumped on logout / password reset), so a short TTL is
# safe: the client silently re-authenticates from the stored token on reload.
JWT_EXPIRES_IN="2h"

# bcrypt work factor for password hashing.
BCRYPT_ROUNDS=12

# Rate limiting for authentication endpoints.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Request body ceilings. The global limit is deliberately small; notes get a
# larger one, and only the file upload routes accept big bodies.
JSON_BODY_LIMIT=100kb
NOTES_BODY_LIMIT=3mb

NODE_ENV=development

# --- Shared rate-limit store (optional) --------------------------------------
# Without these, counters are in-process (fine for local dev / one instance).
# On serverless platforms configure Upstash so limits hold across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Encrypted file storage ------------------------------------------------
# auto (default): Supabase when credentials are present, otherwise local disk.
# local:          private directory on this host (FILE_STORAGE_DIR).
# supabase:       private Supabase Storage bucket (required on Vercel).
STORAGE_DRIVER=auto
FILE_STORAGE_DIR=storage/files
# Maximum size of one encrypted blob.
MAX_FILE_BYTES=26214400
# Request ceiling for the single-request upload path (base64 inflates ~4/3).
MAX_FILE_UPLOAD_BODY_BYTES=37748736
# Per-account encrypted storage ceiling (default 500 MiB).
MAX_USER_STORAGE_BYTES=524288000
# Blobs above this size use the two-step direct-upload flow.
DIRECT_UPLOAD_THRESHOLD_BYTES=4194304
# Lifetime of a signed download URL handed to the browser.
SIGNED_URL_TTL_SECONDS=60

# Supabase Storage (only needed when STORAGE_DRIVER=supabase/auto with creds).
# Create a PRIVATE bucket and set these to the project URL + service-role key.
# The service-role key is server-only and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ciphernote-files

# --- Gmail OTP password reset ----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CipherNote <no-reply@example.com>
OTP_DEBUG_LOG=true
OTP_LENGTH=8
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=4
# openssl rand -base64 32
ESCROW_MASTER_KEY=

# --- Google OAuth sign-in ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
